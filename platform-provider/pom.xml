<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.gaurav.notification</groupId>
        <artifactId>notification-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-provider</artifactId>
    <name>Platform :: Provider</name>
    <dependencies>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-domain</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-application</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-resilience</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>

        <!-- Optional: the chaos admin endpoint (mock/admin) is a web controller, but this module is
             also on the classpath of processes that are not web applications. Marking these
             optional means platform-provider never drags a servlet container into a consumer that
             did not ask for one; ChaosAdminController is @ConditionalOnWebApplication so it simply
             does not register when they are absent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Annotations only, so the endpoints below still document themselves in whichever app
             runs springdoc. Absent at runtime in the worker, which is harmless: the JVM skips
             annotations whose class cannot be loaded. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId><artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.52</version>
            <optional>true</optional>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
