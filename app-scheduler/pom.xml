<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.gaurav.notification</groupId>
        <artifactId>notification-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>app-scheduler</artifactId>
    <name>App :: Scheduler</name>
    <dependencies>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-domain</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-application</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-persistence</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-messaging</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-provider</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-resilience</artifactId></dependency>
        <dependency><groupId>dev.gaurav.notification</groupId><artifactId>platform-observability</artifactId></dependency>
        <!-- Actuator does not bring a servlet container. Without this there is no
             /actuator/health, no /actuator/prometheus, no k8s probe endpoint, and the
             Prometheus scrape target can never come up. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <!-- ApplicationContextSmokeTest loads the whole context; an in-memory database is what
             lets that run with no Docker daemon. PostgreSQL-specific SQL is verified against a
             real 18.6 container in platform-persistence under -Pintegration. -->
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>

        <!--
          ScheduledWorkStoreIntegrationTest runs the real CLAIM_SQL. That statement is a CTE with
          FOR UPDATE SKIP LOCKED feeding an UPDATE … RETURNING against a range-partitioned table,
          and H2 in PostgreSQL-compatibility mode either rejects it or accepts it with different
          locking semantics — which is exactly how a concurrency bug ships under a green suite. So
          the claim is tested on the same 18.6 image the schema was verified against. Tagged
          @Tag("integration") and excluded from the default build, same as platform-persistence.
        -->
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- flyway-core and flyway-database-postgresql arrive transitively from
             platform-persistence at compile scope; re-declaring them here at test scope would
             narrow them and strip Flyway out of the packaged jar's runtime classpath. -->
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- `local` for ./mvnw spring-boot:run only. Deliberately NOT
                         spring.profiles.default, so the packaged jar starts secure. -->
                    <profiles><profile>local</profile></profiles><mainClass>dev.gaurav.notification.scheduler.NotificationSchedulerApplication</mainClass></configuration>
            </plugin>
        </plugins>
    </build>
</project>
